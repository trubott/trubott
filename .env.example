# =================================================================
# trustcard environment configuration
# DEVELOPMENT ONLY - This file is in .gitignore
# Copy from .env.example and fill in your values
# =================================================================

# --- Application ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-a-32-byte-random-string

# --- Database (Postgres) ---
DATABASE_URL=postgresql://trustcard:trustcard@localhost:5433/trustcard

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Reddit Bot (for DM-code verification) ---
# Create a "script" type app at https://www.reddit.com/prefs/apps
# The bot account is whatever Reddit user owns this script app.
REDDIT_CLIENT_ID=local-reddit-client-id
REDDIT_CLIENT_SECRET=local-reddit-client-secret
REDDIT_USERNAME=local_reddit_bot
REDDIT_PASSWORD=local-reddit-password
# Reddit policy requires the UA in the form: "platform:appid:version (by /u/yourname)"
# Replace `yourname` with the username of the account whose API key you used.
REDDIT_USER_AGENT=web:trustcard:0.1.0 (by /u/local_reddit_bot)

# Optional static bot handles shown in UX copy (display only).
# Keep blank to derive dynamically from provider adapters.
REDDIT_BOT_HANDLE=local_reddit_bot
LINKEDIN_BOT_ID=local-linkedin-bot
INSTAGRAM_BOT_ID=local-instagram-bot

# --- LLM (OpenAI-compatible API) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# --- Cryptographic secrets ---
FINGERPRINT_PEPPER=replace-me-with-a-random-string
CARD_SIGNING_SECRET=replace-me-with-a-random-string

# --- Application tunables ---
# Default card TTL in minutes (UI presets are 30 / 60 / 1440 / 10080).
CARD_DEFAULT_TTL_MINUTES=30
# Number of "consistent user" sessions required to surface the passive signal.
PASSIVE_MIN_SESSIONS=3
# Number of days over which those sessions must occur.
PASSIVE_MIN_DAYS=2

# Disable Next.js anonymous telemetry on dev machines.
# Production Docker images already set this in the Dockerfile.
NEXT_TELEMETRY_DISABLED=1

# --- Operations ---
# Run drizzle migrations automatically at server boot.
# Default is "1" in production NODE_ENV; set to "0" to disable if you prefer
# to manage migrations out of band (e.g. via a migration job in CI/CD).
RUN_MIGRATIONS_ON_START=1

# Trust X-Forwarded / CF-* / Vercel-* IP headers when present.
# ONLY set to "1" if your deployment is behind a CDN/proxy that overwrites
# these headers. Otherwise a client can spoof its country code on
# face-check attestations. Default: "0" -> we never store ip_country.
TRUST_PROXY_HEADERS=0

NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername/trustcard
AUTH_TRUST_HOST=true
